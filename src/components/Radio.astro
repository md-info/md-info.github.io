---
import tracks from '../data/radio.json';
---
<div class="radio" transition:persist="portfolio-radio" data-tracks={JSON.stringify(tracks)}>
  <button id="radio-toggle" aria-expanded="false" aria-controls="radio-panel">♫ Radio</button>
  <section id="radio-panel" class="radio-panel" aria-label="Radio player" hidden>
    <div class="radio-top"><span class="radio-label">TORONTO AFTER DARK / RADIO</span><button id="radio-close" aria-label="Close radio">×</button></div>
    <p id="radio-title">{tracks[0].title}</p>
    <div class="radio-meta"><span id="radio-state">PAUSED</span><span id="radio-time">0:00</span></div>
    <div class="radio-controls" role="group" aria-label="Radio controls">
      <button id="radio-prev" aria-label="Previous song">⏮</button>
      <button id="radio-play" aria-label="Play radio">▶</button>
      <button id="radio-next" aria-label="Next song">⏭</button>
      <button id="radio-loop" aria-label="Loop current song" aria-pressed="true">↻</button>
    </div>
    <label class="radio-volume">VOLUME <input id="radio-volume" type="range" min="0" max="100" value="55" aria-label="Radio volume" /></label>
    <audio id="radio-audio" loop preload="none"></audio>
    <span id="radio-message" class="sr-only" role="status" aria-live="polite"></span>
  </section>
</div>
<script>
  const radio=document.querySelector<HTMLElement>('.radio')!;
  const playlist:{title:string;src:string}[]=JSON.parse(radio.dataset.tracks!);
  const audio=radio.querySelector<HTMLAudioElement>('#radio-audio')!;
  const play=radio.querySelector<HTMLButtonElement>('#radio-play')!;
  const loop=radio.querySelector<HTMLButtonElement>('#radio-loop')!;
  const title=radio.querySelector<HTMLElement>('#radio-title')!;
  const state=radio.querySelector<HTMLElement>('#radio-state')!;
  const message=radio.querySelector<HTMLElement>('#radio-message')!;
  const panel=radio.querySelector<HTMLElement>('#radio-panel')!;
  const toggle=radio.querySelector<HTMLButtonElement>('#radio-toggle')!;
  const volume=radio.querySelector<HTMLInputElement>('#radio-volume')!;
  let index=0,baseVolume=.55,inCall=false,fade=0;
  audio.src=playlist[0].src;audio.volume=baseVolume;
  let context:AudioContext|undefined,analyser:AnalyserNode|undefined,bins:Uint8Array<ArrayBuffer>|undefined,spectrumFrame=0;
  function stopSpectrum(){cancelAnimationFrame(spectrumFrame);const spectrum=document.querySelector<HTMLElement>('.radio-spectrum');if(spectrum)spectrum.hidden=true;}
  function drawSpectrum(){
    const spectrum=document.querySelector<HTMLElement>('.radio-spectrum');
    if(audio.paused||audio.ended||document.hidden||!spectrum||!analyser||!bins){stopSpectrum();return;}
    spectrum.hidden=false;analyser.getByteFrequencyData(bins);
    const bars=spectrum.children;
    for(let i=0;i<bars.length;i++){const bin=Math.floor(2*Math.pow(90,i/(bars.length-1)));const level=bins[bin]/255;(bars[i] as HTMLElement).style.height=`${Math.max(1,Math.pow(level,1.7)*130)}%`;}
    spectrumFrame=requestAnimationFrame(drawSpectrum);
  }
  async function startSpectrum(){
    if(!context){context=new AudioContext();analyser=context.createAnalyser();analyser.fftSize=2048;analyser.smoothingTimeConstant=.78;bins=new Uint8Array(analyser.frequencyBinCount);const source=context.createMediaElementSource(audio);source.connect(analyser);analyser.connect(context.destination);}
    await context.resume();cancelAnimationFrame(spectrumFrame);drawSpectrum();
  }
  audio.addEventListener('play',()=>{void startSpectrum();});audio.addEventListener('pause',stopSpectrum);
  document.addEventListener('astro:before-swap',stopSpectrum);
  document.addEventListener('astro:page-load',()=>{if(!audio.paused)void startSpectrum();});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stopSpectrum();else if(!audio.paused)void startSpectrum();});
  function showState(){play.textContent=audio.paused?'▶':'Ⅱ';play.setAttribute('aria-label',audio.paused?'Play radio':'Pause radio');state.textContent=audio.paused?'PAUSED':'ON AIR';toggle.textContent=audio.paused?'♫ Radio':'♫ Radio · LIVE';}
  function open(value:boolean){panel.hidden=!value;toggle.setAttribute('aria-expanded',String(value));if(value)play.focus();}
  toggle.addEventListener('click',()=>open(panel.hidden));
  radio.querySelector('#radio-close')!.addEventListener('click',()=>{open(false);toggle.focus();});
  document.addEventListener('click',event=>{if(!panel.hidden && !radio.contains(event.target as Node))open(false);});
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!panel.hidden){event.preventDefault();event.stopImmediatePropagation();open(false);toggle.focus();}},true);
  document.addEventListener('astro:before-swap',()=>open(false));
  async function start(){try{await audio.play();}catch{message.textContent='Playback could not start. Please try again.';showState();}}
  function select(next:number){const wasPlaying=!audio.paused;index=(next+playlist.length)%playlist.length;audio.src=playlist[index].src;title.textContent=playlist[index].title;radio.querySelector('#radio-time')!.textContent='0:00';showState();message.textContent='Selected '+playlist[index].title;if(wasPlaying)void start();}
  play.addEventListener('click',()=>{if(audio.paused)void start();else audio.pause();});
  loop.addEventListener('click',()=>{audio.loop=!audio.loop;loop.setAttribute('aria-pressed',String(audio.loop));message.textContent=audio.loop?'Loop on':'Loop off';});
  radio.querySelector('#radio-prev')!.addEventListener('click',()=>select(index-1));radio.querySelector('#radio-next')!.addEventListener('click',()=>select(index+1));
  function setVolume(){cancelAnimationFrame(fade);const target=baseVolume*(inCall?.3:1);const from=audio.volume;const begin=performance.now();function step(now:number){const t=Math.min(1,(now-begin)/250);audio.volume=from+(target-from)*t;if(t<1)fade=requestAnimationFrame(step);}fade=requestAnimationFrame(step);}
  volume.addEventListener('input',()=>{baseVolume=Number(volume.value)/100;setVolume();});
  window.addEventListener('portfolio-call',event=>{inCall=Boolean((event as CustomEvent).detail);setVolume();});
  window.addEventListener('portfolio-radio-prepare',()=>{
    if(!audio.paused)return;
    const muted=audio.muted;audio.muted=true;
    void audio.play().then(()=>{audio.pause();audio.muted=muted;}).catch(()=>{audio.muted=muted;});
  });
  window.addEventListener('portfolio-radio-cue',event=>{
    const next=playlist.findIndex(track=>track.src===(event as CustomEvent<string>).detail);
    if(next<0)return;select(next);void start();
  });
  audio.addEventListener('play',showState);audio.addEventListener('pause',showState);
  audio.addEventListener('timeupdate',()=>{const t=Math.floor(audio.currentTime);radio.querySelector('#radio-time')!.textContent=Math.floor(t/60)+':'+String(t%60).padStart(2,'0');});
  audio.addEventListener('ended',()=>{if(!audio.loop){select(index+1);void start();}});
  audio.addEventListener('error',()=>{state.textContent='AUDIO UNAVAILABLE';message.textContent='This track could not load. Try another song.';});
</script>
<style>
  .radio { display:inline-flex; letter-spacing:.03em; }
  #radio-toggle { white-space:nowrap; }
  .radio-panel { position:fixed; z-index:60; bottom:68px; right:42px; width:min(390px,calc(100vw - 48px)); padding:22px; border:1px solid #86edf388; background:linear-gradient(135deg,#251728f5,#091822fa); box-shadow:0 8px 35px #0008; color:var(--hud-cyan); font-family:'Rajdhani',sans-serif; }
  .radio-top { display:flex; justify-content:space-between; align-items:center; gap:15px; }
  .radio-label { font:11px 'IBM Plex Mono',monospace; color:var(--hud-red); }
  #radio-title { font-size:27px; line-height:1.3; margin:18px 0 12px; }
  .radio-meta { display:flex; justify-content:space-between; font:12px 'IBM Plex Mono',monospace; margin-bottom:18px; }
  .radio-controls { display:flex; gap:12px; }
  .radio-controls button { width:54px; height:48px; border:1px solid #86edf366; background:#0b1a27; color:var(--hud-cyan); font-size:24px; }
  .radio-controls button[aria-pressed='true'] { border-color:var(--hud-cyan); background:#17313b; }
  .radio-volume { display:flex; align-items:center; gap:16px; margin-top:22px; font:11px 'IBM Plex Mono',monospace; }
  input { min-width:0; width:100%; accent-color:var(--hud-cyan); }
  @media(max-width:700px) { .radio-panel { right:24px; bottom:64px; } }
</style>
