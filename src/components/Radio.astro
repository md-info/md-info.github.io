---
import tracks from '../data/radio.json';
const available=tracks.filter(track=>track.src);
---
<div class="radio" aria-label="Portfolio radio" data-tracks={JSON.stringify(tracks)}>
  <div class="radio-track"><span class="radio-label">RADIO / <span id="radio-state">{available.length?'PAUSED':'AWAITING AUDIO'}</span></span><span id="radio-title">{tracks[0]?.title ?? 'Menu Atmosphere'}</span></div>
  <div class="radio-controls" role="group" aria-label="Radio controls">
    <button id="radio-prev" aria-label="Previous song" disabled={available.length<2}>⏮</button>
    <button id="radio-play" aria-label="Play radio" disabled={!available.length}>▶</button>
    <button id="radio-next" aria-label="Next song" disabled={available.length<2}>⏭</button>
    <button id="radio-loop" aria-label="Loop current song" aria-pressed="true">↻</button>
  </div>
  <audio id="radio-audio" loop preload="none"></audio>
  <span id="radio-message" class="sr-only" role="status" aria-live="polite"></span>
</div>
<script>
  const radio=document.querySelector<HTMLElement>('.radio')!;
  const tracks: {title:string;src:string|null}[]=JSON.parse(radio.dataset.tracks!);
  const playlist=tracks.filter((track):track is {title:string;src:string}=>!!track.src);
  const audio=document.querySelector<HTMLAudioElement>('#radio-audio')!;
  const play=document.querySelector<HTMLButtonElement>('#radio-play')!;
  const loop=document.querySelector<HTMLButtonElement>('#radio-loop')!;
  const title=document.querySelector<HTMLElement>('#radio-title')!;
  const state=document.querySelector<HTMLElement>('#radio-state')!;
  const message=document.querySelector<HTMLElement>('#radio-message')!;
  let index=0;
  function showState(){ play.textContent=audio.paused?'▶':'Ⅱ';play.setAttribute('aria-label',audio.paused?'Play radio':'Pause radio');state.textContent=playlist.length?(audio.paused?'PAUSED':'ON AIR'):'AWAITING AUDIO'; }
  async function start(){try{await audio.play();}catch{message.textContent='Playback could not start. Please try again.';showState();}}
  function select(next:number){if(!playlist.length)return;const wasPlaying=!audio.paused;index=(next+playlist.length)%playlist.length;audio.src=playlist[index].src;title.textContent=playlist[index].title;showState();message.textContent='Selected '+playlist[index].title;if(wasPlaying)void start();}
  if(playlist.length){audio.src=playlist[0].src;title.textContent=playlist[0].title;}
  play.addEventListener('click',()=>{if(audio.paused)void start();else audio.pause();});
  loop.addEventListener('click',()=>{audio.loop=!audio.loop;loop.setAttribute('aria-pressed',String(audio.loop));message.textContent=audio.loop?'Loop on':'Loop off';});
  document.querySelector('#radio-prev')!.addEventListener('click',()=>select(index-1));
  document.querySelector('#radio-next')!.addEventListener('click',()=>select(index+1));
  audio.addEventListener('play',showState);audio.addEventListener('pause',showState);
  audio.addEventListener('ended',()=>{if(!audio.loop && playlist.length>1){select(index+1);void start();}else showState();});
  audio.addEventListener('error',()=>{state.textContent='AUDIO UNAVAILABLE';message.textContent='This track could not load. Try another song.';});
</script>
<style>
  .radio { display:flex; align-items:center; gap:18px; margin-left:auto; min-width:0; flex:0 1 550px; padding:8px 18px; border-left:1px solid #ff727544; border-right:1px solid #ff727544; letter-spacing:.05em; }
  .radio-track { display:flex; flex-direction:column; gap:3px; min-width:0; flex:1; }
  .radio-label { font-size:10px; color:var(--hud-red); }
  #radio-title { font-family:'Rajdhani',sans-serif; font-size:20px; line-height:1.2; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .radio-controls { display:flex; gap:8px; }
  button { display:grid; place-items:center; width:36px; height:36px; border:1px solid #86edf344; background:#091622; color:var(--hud-cyan); font-size:20px; cursor:pointer; }
  button:disabled { opacity:.35; cursor:default; }
  button[aria-pressed='true'] { border-color:var(--hud-cyan); background:#17313b; }
  @media(max-width:700px) { .radio { flex:1 1 100%; order:5; margin:0; padding:8px 0; border:0; } }
</style>
