---
import Layout from './Layout.astro';
import NoteTree from '../components/NoteTree.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
const formatDate = (date:Date) => new Intl.DateTimeFormat('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}).format(date);
interface Props { post: CollectionEntry<'blog'>; headings: {depth:number;slug:string;text:string}[]; }
const { post, headings } = Astro.props;
const notes = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title, undefined, {numeric:true}));
type Folder = {name:string;children:Folder[];notes:{title:string;url:string;search:string}[]};
const root:Folder = {name:'Journal',children:[],notes:[]};
const folderPath = (note:CollectionEntry<'blog'>) => note.data.folder ?? [note.data.category, ...(note.data.courseCode ? [note.data.courseCode] : [])].join('/');
for (const note of notes) {
  let branch = root;
  for (const name of folderPath(note).split('/').filter(Boolean)) {
    let child = branch.children.find(item=>item.name===name);
    if (!child) { child={name,children:[],notes:[]}; branch.children.push(child); }
    branch=child;
  }
  branch.notes.push({title:note.data.title,url:`/blog/${note.slug}/`,search:[note.data.title,note.data.description,...note.data.tags].join(' ').toLowerCase()});
}
function sortFolders(branch:Folder) { branch.children.sort((a,b)=>a.name.localeCompare(b.name,undefined,{numeric:true})); branch.children.forEach(sortFolders); }
sortFolders(root);
const outline = headings.filter(h=>h.depth>=2 && h.depth<=3);
const related = notes.filter(note=>note.data.listed && note.slug!==post.slug && note.data.tags.some(tag=>post.data.tags.includes(tag)));
---
<Layout title={`${post.data.title} — Michel Deosaran`} description={post.data.description}>
  <div class="note-workspace">
    <details class="note-explorer" open>
      <summary class="pane-label">JOURNAL / EXPLORER</summary>
      <div class="explorer-body">
        <a class="journal-return" href="/blog/">← ALL JOURNAL ENTRIES</a>
        <label for="note-search">Search notes</label>
        <input id="note-search" type="search" placeholder="Title, topic, or text…" autocomplete="off" />
        <p id="search-status" class="search-status" role="status" aria-live="polite">{notes.length} published {notes.length===1?'note':'notes'}</p>
        <nav aria-label="Journal folders"><NoteTree node={root} current={`/blog/${post.slug}/`} /></nav>
      </div>
    </details>
    <article class="note-reader">
      <div class="note-tab"><span aria-hidden="true">▤</span> {post.data.title}<span class="read-mode">READING VIEW</span></div>
      <div class="note-document">
        <p class="note-path">JOURNAL / {folderPath(post)} / NOTE</p>
        <header>
          <h1>{post.data.title}</h1>
          <p class="note-description">{post.data.description}</p>
          <dl class="note-properties"><div><dt>Author</dt><dd>{post.data.author}</dd></div><div><dt>Published</dt><dd><time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time></dd></div>{post.data.updatedDate && <div><dt>Updated</dt><dd>{formatDate(post.data.updatedDate)}</dd></div>}{post.data.courseName && <div><dt>Course</dt><dd>{post.data.courseName}</dd></div>}<div><dt>Tags</dt><dd>{post.data.tags.map(tag=><span class="note-tag">#{tag}</span>)}</dd></div></dl>
        </header>
        {post.data.image && <img class="note-cover" src={post.data.image} alt={post.data.title} />}
        <div class="note-body prose"><slot /></div>
      </div>
    </article>
    <aside class="note-context">
      <details open><summary class="pane-label">ON THIS PAGE</summary><nav aria-label="Note outline">{outline.length ? outline.map(h=><a class:list={['outline-link',{'outline-child':h.depth===3}]} href={`#${h.slug}`}>{h.text}</a>) : <p class="context-empty">This note has no sections.</p>}</nav></details>
      {related.length>0 && <details open><summary class="pane-label">RELATED NOTES</summary>{related.map(note=><a class="outline-link" href={`/blog/${note.slug}/`}>{note.data.title}</a>)}</details>}
    </aside>
  </div>
</Layout>
<script>
  if (window.matchMedia('(max-width:1100px)').matches) { document.querySelectorAll<HTMLDetailsElement>('.note-explorer,.note-context>details').forEach(panel=>panel.open=false); }
  const input=document.querySelector<HTMLInputElement>('#note-search');
  const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-note-search]')];
  const folders=[...document.querySelectorAll<HTMLDetailsElement>('.note-folder')];
  const status=document.querySelector<HTMLElement>('#search-status');
  const initialOpen=new Map(folders.map(folder=>[folder,folder.open]));
  let searchIndex:Promise<Record<string,string>> | undefined;
  let revision=0;
  input?.addEventListener('input',async()=>{
    const currentRevision=++revision;
    const query=input.value.trim().toLowerCase();
    const terms=query.split(/\s+/).filter(Boolean);
    let content:Record<string,string>={};
    if(query){
      try { searchIndex ??= fetch('/blog/search.json').then(response=>{if(!response.ok)throw new Error('Search unavailable');return response.json();}); content=await searchIndex; } catch { searchIndex=undefined; if(status)status.textContent='Full-text search unavailable; searching titles and tags.'; }
    }
    if(currentRevision!==revision)return;
    let count=0;
    for(const link of links){link.hidden=!terms.every(term=>(content[link.getAttribute('href') ?? ''] ?? link.dataset.noteSearch ?? '').includes(term));if(!link.hidden)count++;}
    for(const folder of [...folders].reverse()){
      folder.hidden=query.length>0 && ![...folder.querySelectorAll<HTMLAnchorElement>('[data-note-search]')].some(link=>!link.hidden);
      folder.open=query.length>0 ? !folder.hidden : initialOpen.get(folder) ?? true;
    }
    if(status)status.textContent=query ? (count ? `${count} matching ${count===1?'note':'notes'}` : 'No matching notes. Try another search.') : `${links.length} published ${links.length===1?'note':'notes'}`;
  });
</script>
<style>
  .note-workspace { display:grid; grid-template-columns:280px minmax(0,1fr) 250px; gap:0; margin:24px 0 48px; border:1px solid #ff727544; background:#080f19ed; color:var(--hud-cyan); align-items:start; }
  .note-explorer,.note-context { padding:24px 20px; min-width:0; font-size:20px; line-height:1.5; position:sticky; top:20px; max-height:calc(100svh - 40px); overflow:auto; }
  .note-explorer { border-right:1px solid #ff727544; }
  .note-context { border-left:1px solid #ff727544; }
  .pane-label { font:14px 'IBM Plex Mono',monospace; color:var(--hud-red); letter-spacing:.06em; cursor:pointer; margin-bottom:22px; }
  .journal-return { display:block; font-size:17px; margin-bottom:30px; }
  label { display:block; font-size:18px; margin-bottom:8px; }
  input { width:100%; min-width:0; padding:12px; border:1px solid #86edf366; background:#0d1b27; color:var(--hud-cyan); font:inherit; font-size:19px; border-radius:0; }
  input::placeholder { color:#86edf3a0; }
  input:focus-visible { outline:2px solid var(--hud-cyan); outline-offset:3px; }
  .search-status { font-size:16px; margin:12px 0 24px; min-height:24px; }
  .note-reader { min-width:0; }
  .note-tab { display:flex; gap:12px; align-items:center; padding:18px 24px; background:#1c1726; border-bottom:1px solid #ff727544; font-size:18px; overflow-wrap:anywhere; }
  .read-mode { margin-left:auto; font:11px 'IBM Plex Mono',monospace; white-space:nowrap; color:var(--hud-red); }
  .note-document { padding:clamp(24px,3vw,56px); }
  .note-path { font:13px 'IBM Plex Mono',monospace; line-height:1.7; margin:0 0 26px; overflow-wrap:anywhere; }
  .note-document h1 { font-size:clamp(36px,3.4vw,62px); margin:0 0 24px; line-height:1.12; }
  .note-description { font-size:26px; line-height:1.6; margin-bottom:28px; }
  .note-properties { border-top:1px solid #ff727544; border-bottom:1px solid #ff727544; padding:20px 0; margin-bottom:40px; font-size:20px; }
  .note-properties>div { display:grid; grid-template-columns:100px minmax(0,1fr); gap:16px; margin:8px 0; }
  dt { color:var(--hud-red); } dd { margin:0; overflow-wrap:anywhere; }
  .note-tag { display:inline-block; margin-right:14px; }
  .note-cover { width:100%; margin-bottom:32px; }
  .outline-link { display:block; font-size:18px; padding:10px 0; border-bottom:1px solid #ff727522; overflow-wrap:anywhere; }
  .outline-child { padding-left:16px; }
  .context-empty { font-size:18px; }
  .note-context details+details { margin-top:32px; }
  .note-body { max-width:none; font-size:26px; line-height:1.75; overflow-wrap:anywhere; }
  .note-body :global(h1) { font-size:36px; margin:36px 0 22px; }
  .note-body :global(h2),.note-body :global(h3) { scroll-margin-top:24px; line-height:1.3; margin:36px 0 18px; }
  .note-body :global(p),.note-body :global(ul),.note-body :global(ol) { margin:18px 0; }
  .note-body :global(ul) { list-style:disc; padding-left:28px; }
  .note-body :global(ol) { list-style:decimal; padding-left:28px; }
  .note-body :global(li) { margin:8px 0; }
  .note-body :global(blockquote) { border-left:3px solid var(--hud-cyan); background:#10232d; padding:16px 24px; margin:24px 0; }
  .note-body :global(pre) { max-width:100%; overflow:auto; padding:22px; background:#050a12; border:1px solid #86edf344; }
  .note-body :global(table) { display:block; max-width:100%; overflow:auto; }
  .note-body :global(img) { max-width:100%; height:auto; }
  .note-body :global(a) { color:var(--hud-cyan); text-decoration:underline; text-underline-offset:4px; }
  .note-workspace :global(.note-folder) { margin:12px 0; }
  .note-workspace :global(.note-folder summary) { cursor:pointer; color:var(--hud-red); overflow-wrap:anywhere; padding:7px 0; }
  .note-workspace :global(.folder-children) { margin-left:10px; padding-left:12px; border-left:1px solid #ff727533; }
  .note-workspace :global([data-note-search]) { display:flex; gap:8px; padding:12px 10px; font-size:19px; line-height:1.5; overflow-wrap:anywhere; }
  .note-workspace :global([data-note-search][aria-current='page']) { background:#143440; border-left:2px solid var(--hud-cyan); }
  .note-workspace :global([hidden]) { display:none!important; }
  .note-workspace a:hover { color:var(--hud-red); }
  @media(max-width:1500px) { .note-workspace { grid-template-columns:230px minmax(0,1fr) 190px; } .note-explorer,.note-context { padding:20px 16px; } .read-mode { display:none; } }
  @media(max-width:1100px) { .note-workspace { grid-template-columns:minmax(0,1fr); } .note-explorer { position:static; max-height:none; border-right:0; border-bottom:1px solid #ff727544; } .note-context { grid-column:1; grid-row:2; position:static; max-height:none; border-left:0; border-bottom:1px solid #ff727544; } .note-reader { grid-row:3; } .note-explorer { grid-row:1; } .note-tab { padding:16px; } .read-mode { display:none; } .note-document { padding:24px 20px; } .note-body { font-size:24px; } .note-properties>div { grid-template-columns:80px minmax(0,1fr); gap:10px; } }
</style>



