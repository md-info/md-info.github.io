---
import Layout from '../layouts/Layout.astro';
---
<Layout home title="Michel Deosaran — Toronto After Dark" description="Enter Michel Deosaran's portfolio. Computing, cybersecurity, and business development, through a Toronto after-dark interface.">
  <div class="home-topline"><span><i class="status-light"></i> CONNECTION ESTABLISHED</span><span>PERSONAL PORTFOLIO / 2026</span></div>
  <aside id="incoming-call" class="incoming-call" aria-label="Incoming call from Michel" hidden>
    <div class="call-label">INCOMING CONNECTION</div><div class="call-icon" aria-hidden="true">⌁</div>
    <strong>MICHEL DEOSARAN</strong><span class="call-status">PERSONAL LINE / TORONTO</span>
    <div class="call-actions"><button id="answer-call">ANSWER ↗</button><button id="decline-call">DECLINE</button></div>
  </aside>
  <aside id="active-call" class="active-call" aria-label="Active call with Michel" hidden>
    <div class="call-label">MICHEL DEOSARAN <span>● LIVE</span></div>
    <div class="caller-feed"><img src="/images/michel-caller.png" alt="Michel Deosaran" width="936" height="1047" /><div class="caller-scan" aria-hidden="true"></div></div>
    <button id="end-call" aria-label="End call with Michel">END CALL ×</button>
    <div class="call-languages" role="group" aria-label="Call language"><button data-call-language="en" aria-label="English">EN</button><button data-call-language="fr" aria-label="Français">FR</button><button data-call-language="ja" aria-label="日本語">JA</button></div>
  </aside>
  <div class="welcome-copy"><p class="eyebrow">WELCOME TO MY CORNER OF THE CITY</p><h1>Curious mind.<br />Connected <em>world.</em></h1><div class="intro-dialogue" aria-label="Conversation with Michel">
    <p class="home-description dialogue-subtitle" id="call-subtitle"><span class="dialogue-speaker" hidden>Michel:</span> <span id="dialogue-line">I'm Michel. Toronto looks good from here, right? Give a city a little darkness and suddenly even the concrete has personality. Anyway—glad you picked up. What's on your mind?</span></p>
    <span id="call-announcement" class="sr-only" aria-live="polite" aria-atomic="true"></span>
    <div id="dialogue-choices" class="dialogue-choices" role="group" aria-label="Choose your reply" hidden>
      <a href="/profile/" class="dialogue-choice dialogue-progress" id="dialogue-progress"><span aria-hidden="true">›</span> <span class="progress-text">All right. Let me look around.</span> <span class="dialogue-action" aria-hidden="true">↗</span></a>
      <button class="dialogue-choice" data-reply="banter"><span aria-hidden="true">›</span> <span class="reply-text">You always call strangers like this?</span></button>
      <button class="dialogue-choice" data-reply="work"><span aria-hidden="true">›</span> <span class="reply-text">So, what's keeping you up?</span></button>
      <button class="dialogue-choice" data-reply="radio"><span aria-hidden="true">›</span> <span class="reply-text">What's on your radio tonight?</span></button>
    </div>
    <a class="enter-button" id="return-profile" href="/profile/"><span>ENTER PROFILE</span><span>↗</span></a>
  </div></div>
  <div class="home-bottom"><div><span class="eyebrow">CURRENT PURSUIT</span><p>Computing & Information Systems</p><small>Athabasca University</small></div><div class="scene-caption"><span>01—02 / TORONTO AT NIGHT</span><div class="scene-progress"></div><small>A city in motion. A mind at work.</small></div></div>
  <noscript><p class="no-script">All portfolio pages are available through the main menu. JavaScript adds sound, settings, and the arcade.</p></noscript>
</Layout>

<script src="../scripts/intro-call.ts"></script>

