---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Michel Deosaran"
  description="Technology Sales professional specializing in revenue growth, client engagement, and technical solutions. B.Sc. Computing & Information Systems with experience across cybersecurity, IT infrastructure, and software development."
>

  <div
    class="grid grid-cols-1 md:grid-cols-3 gap-8 animate-stagger"
  >
    <div
      class="card p-6 animate-scale-in"
      style="--index: 0;"
    >
      <h3
        class="text-xl font-semibold text-primary mb-4"
      >
        Technology Sales & Revenue 🚀
      </h3>

      <div class="space-y-2">

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            B2B Sales Development
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Prospect Research & Lead Generation
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Client Discovery & Qualification
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Personalized Outreach Campaigns
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            CRM & Sales Pipeline Management
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Technical Solution Communication
          </span>
        </div>

      </div>
    </div>


    <div
      class="card p-6 animate-scale-in"
      style="--index: 1;"
    >
      <h3
        class="text-xl;font-semibold text-primary mb-4"
      >
        Cybersecurity & IT Infrastructure 🔐
      </h3>

      <div class="space-y-2">

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Red Teaming Fundamentals
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Network Security Concepts
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            TCP/IP, Routing & Switching
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            CCNA Networking Concepts
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Linux & Systems Administration
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Security Research & Testing
          </span>
        </div>

      </div>
    </div>


    <div
      class="card p-6 animate-scale-in"
      style="--index: 2;"
    >
      <h3
        class="text-xl font-semibold text-primary mb-4"
      >
        Computing & Technical Skills 💻
      </h3>

      <div class="space-y-2">

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Python, JavaScript, TypeScript
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            React, Astro, Tailwind, Node.js
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            SQL, PostgreSQL, MySQL
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Web Development & Digital Platforms
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Technical Writing & Media Production
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          <span class="text-secondary">
            Research Communication
          </span>
        </div>

      </div>
    </div>

  </div>

</div>
