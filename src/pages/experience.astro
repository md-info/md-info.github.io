---
import Layout from '../layouts/Layout.astro';
const files = [
  { number: '01', title: 'Education', subtitle: 'Computing & Information Systems', text: 'Athabasca University. A foundation in software, systems, and the way people use technology.', href: '/experience/education/', tag: 'ACADEMIC RECORD' },
  { number: '02', title: 'Work', subtitle: 'Business development', text: 'Freelance outreach and sales development through Michael & Zion Revenue Group.', href: '/experience/work/', tag: 'PROFESSIONAL RECORD' },
  { number: '03', title: 'Community', subtitle: 'Student affairs & leadership', text: 'Workgroup for Resilient Industrial Systems. Student resources, communication, and community building.', href: '/experience/extracurricular/', tag: 'COMMUNITY RECORD' },
];
---
<Layout title="Experience — Michel Deosaran">
  <div class="dossier-content"><p class="eyebrow">03 / EXPERIENCE RECORD</p><h1>Learning. Building.<br /><em>Connecting.</em></h1><p class="lead">Three parts of the same journey.</p><div class="experience-files">{files.map(file => <a class="experience-file" href={file.href}><div class="experience-number">{file.number}</div><span class="eyebrow">{file.tag}</span><h2>{file.title}</h2><h3>{file.subtitle}</h3><p>{file.text}</p><span class="file-action">OPEN RECORD <b>↗</b></span></a>)}</div></div>
</Layout>
