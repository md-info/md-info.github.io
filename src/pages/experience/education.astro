---
import Layout from '../../layouts/Layout.astro';
const education = [
 { institution:'Athabasca University', program:'Bachelor of Science, Computing and Information Systems', dates:'May 2023 – Present', details:['Athabasca Philomatheans','2025–2026 Honor Roll'], skills:['Research Methods','Statistics'], links:[{label:'Program website',url:'https://www-preview.athabascau.ca/science-and-technology/programs/bachelor-of-science-in-computing-and-information-systems.html'}] },
 { institution:'Humber Polytechnic', program:'Coursework, Biomedical Sciences, General', dates:'Sep 2019 – May 2023', details:['Health Science Certificate','Research Fundraising Committee — Member','Biotechnology coursework','Paramedical Science coursework'], skills:['Leadership','Teamwork'], links:[] },
 { institution:'York University', program:'Coursework, Mathematics', dates:'Sep 2021 – May 2022', details:['Calculus II','Calculus I'], skills:['Advanced Mathematics'], links:[] },
];
const certifications = [
 { title:'Education in Quantitative Finance (Cert.)', issuer:'Udemy', description:'Completed Algorithmic Stock Trading and Equity Investing with Python, taught by Alexander Hagmann, on August 26, 2026.', skills:['Financial Modeling','Investment Analysis'], credentialId:'', link:{label:'Udemy profile',url:'https://www.udemy.com/user/mikey-deosaran/'} },
 { title:'Upper Intermediate (CEFR)', issuer:'The Japan Foundation, Toronto', description:'Japanese language studies.', skills:['英訳','Japanese Translation'], credentialId:'', link:{label:'Learning profile',url:'https://www.italki.com/user/33018287'} },
 { title:'Bilingual Studies (OSSD)', issuer:'Ontario Ministry of Education', description:'Bilingual studies with French translation skills.', skills:['French Translation'], credentialId:'', link:null },
 { title:'Education in Software Development (Cert.)', issuer:'Udemy', description:'Completed The Web Developer Bootcamp 2026, taught by Colt Steele, on August 26, 2026.', skills:['Web Development'], credentialId:'UC-3440d788-4ccf-40e7-a96f-ffb721dca650', link:{label:'Show credential',url:'https://www.udemy.com/certificate/UC-3440d788-4ccf-40e7-a96f-ffb721dca650/'} },
];
---
<Layout title="Education & Certifications — Michel Deosaran" description="Michel Deosaran's education, academic honors, licenses, and certifications.">
 <div class="dossier-content">
  <p class="eyebrow">03 / EDUCATION RECORD</p><h1>Education &amp; <em>certifications.</em></h1>
  <p class="lead">Academic foundations in computing, science, and mathematics. Continued learning in finance, software development, and languages.</p>
  <section aria-labelledby="education-heading">
   <h2 id="education-heading" class="text-3xl mb-6">Education</h2>
   <div class="space-y-6">{education.map((record,index)=><article class="card p-6 sm:p-8 animate-slide-in-left" style={`--index:${index}`}>
    <p class="eyebrow mb-3">{record.dates}</p><h3 class="text-2xl text-accent mb-2">{record.institution}</h3>
    <p class="text-xl text-accent mb-5">{record.program}</p>
    <ul class="body-copy list-disc pl-6 mb-5">{record.details.map(detail=><li>{detail}</li>)}</ul>
    <div class="skill-tags" aria-label="Skills">{record.skills.map(skill=><span>{skill}</span>)}</div>
    <div class="project-links">{record.links.map(link=><a class="enter-button" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}{index===0 && <a class="enter-button" href="/coursework/">Coursework archive ↗</a>}</div>
   </article>)}</div>
  </section>
  <section aria-labelledby="certifications-heading" class="mt-12">
   <h2 id="certifications-heading" class="text-3xl mb-6">Licenses &amp; certifications</h2>
   <div class="project-grid">{certifications.map((record,index)=><article class="card p-6 sm:p-8 animate-slide-in-left" style={`--index:${index}`}>
    <p class="eyebrow mb-3">{record.issuer}</p><h3 class="text-2xl text-accent mb-4">{record.title}</h3>
    <p class="body-copy">{record.description}</p>
    {record.credentialId && <p class="text-accent mt-4 break-all">Credential ID: {record.credentialId}</p>}
    <div class="skill-tags" aria-label="Skills">{record.skills.map(skill=><span>{skill}</span>)}</div>
    {record.link && <a class="enter-button" href={record.link.url} target="_blank" rel="noopener noreferrer">{record.link.label} ↗</a>}
   </article>)}</div>
  </section>
  <a class="record-back" href="/experience/">← EXPERIENCE ARCHIVE</a>
 </div>
</Layout>
