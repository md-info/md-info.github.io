---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).filter(post => post.data.category.toLowerCase().includes('research'));
---
<Layout title="Research — Michel Deosaran" description="Michel's interests in information systems and computing education.">
  <div class="dossier-content"><p class="eyebrow">04 / RESEARCH LOG</p><h1>Understanding<br />the <em>system.</em></h1><p class="lead">Exploring Information Systems and Computer Science Education.</p><div class="profile-grid"><div class="body-copy"><p>My research interests sit at the intersection of computing, education, and the way people work with technology.</p><p>I document ideas, reading, and reflections through technical writing and educational media. This log is a space for that work as it develops.</p><a class="enter-button" href="/blog/">OPEN JOURNAL <span>↗</span></a></div><aside class="profile-facts"><p class="eyebrow">RELATED READING</p>{posts.map(post => <a class="research-link" href={`/blog/${post.slug}/`}>{post.data.title} ↗</a>)}<a class="research-link" href="https://micheldeosaran.medium.com/">Writing on Medium ↗</a><a class="research-link" href="https://www.youtube.com/@LeroyLock">Technical essays on Leroy Lock ↗</a></aside></div></div>
</Layout>
